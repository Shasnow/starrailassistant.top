---
// 下载页：复用 Starlight 页头，不显示文档侧边栏；文案由 i18n 提供
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import DownloadPage from "@/components/download/DownloadPage.astro";

const tr = Astro.locals.t;
---

<StarlightPage
  frontmatter={{
    title: tr("download.meta.title"),
    description: tr("download.meta.description"),
    template: "splash",
    editUrl: false,
    lastUpdated: false,
  }}
  hasSidebar={false}
>
  <div class="not-content">
    <DownloadPage />
  </div>
</StarlightPage>
